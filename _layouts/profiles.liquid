---
layout: page
---
<div class="people">
  {{ content }}
  <nav class="page-jumps" aria-label="People sections">
    <a href="#faculty">Faculty</a>
    <a href="#students">Current students</a>
    <a href="#alumni">Alumni</a>
  </nav>
  {% for group in site.data.people.groups %}
    <section class="people-group people-group--{{ group.id }}" aria-labelledby="{{ group.id }}">
      <h2 id="{{ group.id }}">{{ group.title }}</h2>
      <div class="people-grid">
        {% for member in group.members %}
          <article class="member{% if member.director %} member--director{% endif %}" id="{{ member.id }}">
            {% if member.image %}
              <div class="member-portrait">
                {% assign portrait = member.image | prepend: 'assets/img/' %}
                {% include figure.liquid path=portrait alt=member.alt width=1368 height=2100 sizes="(min-width: 768px) 180px, 140px" loading="eager" %}
              </div>
            {% endif %}
            <div class="member-main">
              <h3>{{ member.name }}</h3>
              <p class="member-role">{{ member.role }}</p>
              {% capture biography %}{% include {{ member.bio }} %}{% endcapture %}
              {% assign sections = biography | split: '<!--more-->' %}
              {{ sections.first | markdownify }}
              {% if sections.size > 1 %}
                <details class="member-details">
                  <summary>More about {{ member.name }}</summary>
                  <div class="member-bio">{{ sections.last | markdownify }}</div>
                </details>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
  <section class="alumni-section" aria-label="Alumni and historical affiliations">
    {% capture alumni %}{% include people/alumni.md %}{% endcapture %}
    {{ alumni | markdownify }}
  </section>
</div>
