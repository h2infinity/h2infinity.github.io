<section class="funded-projects" aria-labelledby="funding-title">
  <div class="section-heading">
    <div>
      <p class="section-eyebrow">Sponsored research</p>
      <h2 id="funding-title">Funding &amp; projects</h2>
    </div>
    <a class="text-link" href="{{ site.data.funded_projects.source_url }}">Official UTK grants profile <span aria-hidden="true">↗</span></a>
  </div>
  <p class="section-intro">
    Explore Professor Djouadi's sponsored-project records in the university's grants profile. Research themes and representative contributions are
    listed below.
  </p>
  {% if site.data.funded_projects.projects.size > 0 %}
    <p class="content-note">
      These awards are recorded as funded. Their listed dates describe the award period; historical awards are not presented as currently active.
    </p>
    <div class="grant-grid">
      {% assign awards = site.data.funded_projects.projects | sort: 'start_date' | reverse %}
      {% for grant in awards %}
        <article class="grant-card" id="{{ grant.id }}">
          <p class="grant-status">Funded</p>
          <h3>{{ grant.title | escape }}</h3>
          <p class="grant-sponsor">{{ grant.sponsor | escape }}</p>
          {% if grant.start_date and grant.end_date %}
            <p class="grant-period">
              <time datetime="{{ grant.start_date }}">{{ grant.start_date | date: '%b %Y' }}</time> –
              <time datetime="{{ grant.end_date }}">{{ grant.end_date | date: '%b %Y' }}</time>
            </p>
          {% endif %}
          {% if grant.award_id %}
            <p class="grant-id">Award {{ grant.award_id | escape }}</p>
          {% endif %}
          {% if grant.description %}
            <p>{{ grant.description | escape }}</p>
          {% endif %}
          <a class="text-link" href="{{ grant.source_url }}">Award source <span aria-hidden="true">↗</span></a>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>
