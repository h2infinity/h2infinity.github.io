<section class="home-section">
  <div class="section-heading">
    <div>
      <p class="section-eyebrow">Ideas into systems</p>
      <h2>Research themes</h2>
    </div>
    <a class="text-link" href="{{ '/projects/' | relative_url }}">Explore all themes <span aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="research-grid">
    {% assign themes = site.projects | sort: 'importance' %}
    {% for theme in themes %}
      <a class="research-card" href="{{ theme.url | relative_url }}">
        <span class="theme-index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
        <h3>{{ theme.title }}</h3>
        <p>{{ theme.description }}</p>
        <span class="theme-more">Explore theme <span aria-hidden="true">&rarr;</span></span>
      </a>
    {% endfor %}
  </div>
</section>
