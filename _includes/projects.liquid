<div class="col">
  <article class="card h-100">
    <a class="project-card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% if project.img %}
        {% include figure.liquid loading="lazy" path=project.img sizes="350px" alt=project.title class="card-img-top" %}
      {% endif %}
      <div class="card-body">
        <span class="theme-index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        <span class="theme-more">Explore theme <span aria-hidden="true">&rarr;</span></span>
      </div>
    </a>
    {% if project.github %}
      <a class="project-code-link" href="{{ project.github }}">Project code <span aria-hidden="true">&nearr;</span></a>
    {% endif %}
  </article>
</div>
