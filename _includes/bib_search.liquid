{% if site.bib_search %}
  <div class="publication-search">
    <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
    <input
      type="search"
      id="bibsearch"
      aria-label="Filter publications by title, author, venue, or year"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="Filter by title, author, venue, or year"
    >
  </div>
{% endif %}
